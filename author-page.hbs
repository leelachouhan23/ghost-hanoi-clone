{{!< default}}

{{#author}}
<div class="archive-hero author-hero" style="{{#if cover_image}}background-image: url({{img_url cover_image size='xl'}});{{else}}background-image: url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=2000&auto=format&fit=crop');{{/if}}">
    <div class="archive-hero-overlay"></div>
    
    <div class="container archive-hero-content author-hero-content">
        {{#if profile_image}}
            <img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" />
        {{else}}
            <img class="author-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop" alt="{{name}}" />
        {{/if}}

        <h1 class="archive-title author-title">{{name}}</h1>
        
        {{#if bio}}
            <p class="archive-description author-bio">{{bio}}</p>
        {{else}}
            <p class="archive-description author-bio">Emma writes about photography, travel, culture, and the field notes that turn everyday places into lasting stories.</p>
        {{/if}}

        {{#if location}}
            <div class="author-location">{{location}}</div>
        {{else}}
            <div class="author-location">New York, USA</div>
        {{/if}}

        <div class="author-social-links">
            {{#if website}}
                <a href="{{website}}" target="_blank" rel="noopener" aria-label="Website">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                </a>
            {{/if}}
            <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9z"/></svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
        </div>
    </div>
</div>
{{/author}}

<main class="site-main container author-main">
    <div class="author-post-grid">
        {{#foreach posts}}
            <article class="author-post-card">
                {{#if feature_image}}
                    <a href="{{url}}" class="author-post-image-wrap">
                        <img class="author-post-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" />
                    </a>
                {{/if}}
                
                <div class="author-post-content">
                    {{#if primary_tag}}
                        <a class="author-post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                    {{/if}}
                    
                    <h2 class="author-post-title"><a href="{{url}}">{{title}}</a></h2>
                    
                    <div class="author-post-meta">
                        <div class="author-post-authors">
                            {{#foreach authors}}
                                <a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}
                            {{/foreach}}
                        </div>
                        <time class="author-post-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
                    </div>
                </div>
            </article>
        {{/foreach}}
    </div>

    {{#if pagination.next}}
        <div class="author-load-more-wrap">
            <a href="{{page_url pagination.next}}" class="author-load-more-btn">Load more posts</a>
        </div>
    {{/if}}

    {{> "newsletter"}}
</main>
