{{!< default}}

{{!--
  page.hbs — Static page template
  TODO (page-template owner): implement custom page layout.
  Stub below provides the minimum required by Ghost theme spec.
--}}

{{#page}}
<article class="page-template {{post_class}}" itemscope itemtype="https://schema.org/WebPage">

    {{#if @page.show_title_and_feature_image}}
    <header class="article-header container">
        <h1 class="article-title" itemprop="name">{{title}}</h1>
    </header>

    {{#if feature_image}}
    <div class="article-image-wrap container">
        <img
            class="article-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w"
            sizes="(max-width: 1000px) 100vw, 1000px"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        />
    </div>
    {{/if}}
    {{/if}}

    <div class="article-body container" itemprop="text">
        {{content}}
    </div>

</article>
{{/page}}
