{{!< default}}

{{#post}}
<article class="post-full page-full">
  {{#if feature_image}}
    <img class="post-full-image" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
  {{/if}}

  <div class="post-full-content">
    <h1 class="post-full-title">{{title}}</h1>

    <div class="post-full-body gh-content gh-canvas">
      {{content}}
    </div>
  </div>
</article>
{{/post}}
