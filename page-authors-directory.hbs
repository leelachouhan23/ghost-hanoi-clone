{{!< default}} {{#post}} <div class="archive-hero"
    style="{{#if feature_image}}background-image: url({{img_url feature_image size='xl'}});{{else}}background-image: url('https://images.unsplash.com/photo-1587829741301-dc798b83add3?q=80&w=2000&auto=format&fit=crop');{{/if}}">
    <div class="archive-hero-overlay"></div>

    <div class="container archive-hero-content">
        <h1 class="archive-title">{{title}}</h1>
        {{#if custom_excerpt}}
        <p class="archive-description">{{custom_excerpt}}</p>
        {{else if excerpt}}
        <p class="archive-description">{{excerpt}}</p>
        {{else}}
        <p class="archive-description">Meet the writers, editors, and collaborators behind the publication.</p>
        {{/if}}
    </div>
    </div>
    {{/post}}

    <main class="site-main container authors-directory-main">
        <section class="authors-directory-section">
            <div class="authors-grid">
                {{#get "authors" limit="all" include="count.posts"}}
                {{#foreach authors}}
                <div class="author-dir-card">
                    <div class="author-dir-cover"
                        style="background-image: url('{{#if cover_image}}{{img_url cover_image size="
                        m"}}{{else}}https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1000&auto=format&fit=crop{{/if}}');">
                    </div>
                    <div class="author-dir-body">
                        <a href="{{url}}" class="author-dir-avatar-link">
                            {{#if profile_image}}
                            <img class="author-dir-avatar" src="{{img_url profile_image size=" s"}}" alt="{{name}}" />
                            {{else}}
                            <img class="author-dir-avatar"
                                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=300&auto=format&fit=crop"
                                alt="{{name}}" />
                            {{/if}}
                        </a>
                        <h2 class="author-dir-name"><a href="{{url}}">{{name}}</a></h2>
                        {{#if bio}}
                        <p class="author-dir-bio">{{bio}}</p>
                        {{else}}
                        <p class="author-dir-bio">Emma writes about photography, travel, culture, and the field notes
                            that turn everyday places into lasting stories.</p>
                        {{/if}}
                        {{#if location}}
                        <div class="author-dir-location">{{location}}</div>
                        {{else}}
                        <div class="author-dir-location">New York, USA</div>
                        {{/if}}
                        <div class="author-dir-social">
                            {{#if website}}
                            <a href="{{website}}" target="_blank" rel="noopener" aria-label="Website">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                </svg>
                            </a>
                            {{/if}}
