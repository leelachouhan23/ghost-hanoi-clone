{{!< default}}

{{!-- Header Component --}}
{{> "header"}}

{{!-- Latest Stories Hero Banner --}}
<section class="latest-hero-banner">
    <div class="latest-hero-container">
        <h1 class="latest-page-title">Latest Stories</h1>
    </div>
</section>

{{!-- Latest Posts Grid --}}
{{> "latest-posts"}}

{{!-- Footer Component --}}
{{#if @partial-exists "footer"}}
    {{> "footer"}}
{{else}}
    <footer style="padding: 40px 32px; text-align: center; color: #78716c; font-size: 0.88rem; border-top: 1px solid #e7e2d7;">
        <p>&copy; {{date format="YYYY"}} {{@site.title}} • Powered by Ghost</p>
    </footer>
{{/if}}
