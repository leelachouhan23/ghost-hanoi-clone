<section class="brand-section">
    <div class="container">
        {{#if @custom.brand_statement}}
            <h2 class="brand-text" id="brand-statement-text" data-image="{{#if @site.cover_image}}{{@site.cover_image}}{{else}}{{asset 'images/placeholder.jpg'}}{{/if}}">
                {{@custom.brand_statement}}
            </h2>
        {{else}}
            <h2 class="brand-text" id="brand-statement-text" data-image="{{#if @site.cover_image}}{{@site.cover_image}}{{else}}{{asset 'images/placeholder.jpg'}}{{/if}}">
                A journal on design, interiors, photography, travel, and culture, for readers who notice how images and places [IMAGE] shape a story.
            </h2>
        {{/if}}
        
        <div class="brand-social">
            {{#if @site.facebook}}
                <a href="https://www.facebook.com/{{@site.facebook}}" aria-label="Facebook">FB</a>
            {{/if}}
            {{#if @site.twitter}}
                <a href="https://x.com/{{@site.twitter}}" aria-label="Twitter">X</a>
            {{/if}}
            <a href="https://instagram.com" aria-label="Instagram">IG</a>
            <a href="https://linkedin.com" aria-label="LinkedIn">LI</a>
        </div>
    </div>
</section>
