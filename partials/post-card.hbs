{{!--
  partials/post-card.hbs
  Reusable card used by any post feed/loop.
  Accepts the current post as context (call inside {{#foreach posts}}).
--}}

<article class="post-card {{post_class}}">

    <a class="post-card__img-link" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img
                class="post-card__img"
                srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                loading="lazy"
            />
        {{else}}
            <div class="post-card__img post-card__img--fallback" aria-hidden="true"></div>
        {{/if}}
    </a>

    <div class="post-card__content">
        {{#primary_tag}}
            <a class="hanoi-tag-label hanoi-tag-label--sm" href="{{url}}">{{name}}</a>
        {{/primary_tag}}

        <h3 class="post-card__title">
            <a href="{{url}}">{{title}}</a>
        </h3>

        <p class="post-card__excerpt">{{excerpt words="20"}}</p>

        <div class="post-card__meta">
            {{#foreach authors limit="2"}}
                {{#if profile_image}}
                    <img class="hanoi-author-avatar"
                         src="{{img_url profile_image size="xs"}}"
                         alt="{{name}}" />
                {{/if}}
                <span class="hanoi-author-name">{{name}}</span>{{#unless @last}}&thinsp;&amp;&thinsp;{{/unless}}
            {{/foreach}}
            <span class="hanoi-meta-sep" aria-hidden="true">&middot;</span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
        </div>
    </div>

</article>

