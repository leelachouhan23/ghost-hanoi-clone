<article class="post-card">
  <a href="{{url}}" class="post-card-image-link">
    {{#if feature_image}}
      <img class="post-card-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
    {{else}}
      <div class="post-card-image-placeholder">
        <div class="placeholder-icon">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    {{/if}}
  </a>
  <div class="post-card-content">
    {{#if primary_tag}}
      <span class="post-card-tag">{{primary_tag.name}}</span>
    {{/if}}
    <a href="{{url}}"><h2 class="post-card-title">{{title}}</h2></a>
    <div class="post-card-meta">
      {{#foreach authors}}
        <span class="post-card-author">{{name}}</span>{{#unless @last}}, {{/unless}}
      {{/foreach}}
      <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
    </div>
  </div>
</article>