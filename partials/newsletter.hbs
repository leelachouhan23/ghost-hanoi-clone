<section class="newsletter-section">
    <div class="newsletter-card">
        <div class="newsletter-image-wrap">
            <img src="{{#if @custom.newsletter_image}}{{@custom.newsletter_image}}{{else}}https://images.unsplash.com/photo-1587829741301-dc798b83add3?q=80&w=1200&auto=format&fit=crop{{/if}}" alt="{{#if @custom.newsletter_title}}{{@custom.newsletter_title}}{{else}}Letters from {{@site.title}}{{/if}}" class="newsletter-image" />
        </div>
        <div class="newsletter-content">
            <h2 class="newsletter-title">{{#if @custom.newsletter_title}}{{@custom.newsletter_title}}{{else}}Letters from {{@site.title}}{{/if}}</h2>
            <p class="newsletter-subtitle">{{#if @custom.newsletter_description}}{{@custom.newsletter_description}}{{else}}A quiet edit of new stories, images, references, and notes on creative culture.{{/if}}</p>

            <div class="newsletter-options">
                <label class="newsletter-option">
                    <input type="checkbox" class="newsletter-checkbox" checked />
                    <div class="newsletter-option-text">
                        <span class="newsletter-option-title">Weekly Edit</span>
                        <span class="newsletter-option-desc">New stories and visual references from {{@site.title}}, sent once a week.</span>
                    </div>
                </label>

                <label class="newsletter-option">
                    <input type="checkbox" class="newsletter-checkbox" />
                    <div class="newsletter-option-text">
                        <span class="newsletter-option-title">Field Notes</span>
                        <span class="newsletter-option-desc">Short observations on photography, interiors, travel, food, and place.</span>
                    </div>
                </label>

                <label class="newsletter-option">
                    <input type="checkbox" class="newsletter-checkbox" />
                    <div class="newsletter-option-text">
                        <span class="newsletter-option-title">Studio Letter</span>
                        <span class="newsletter-option-desc">Occasional notes on process, materials, and creative practice.</span>
                    </div>
                </label>
            </div>

            <form class="newsletter-form" data-members-form="subscribe">
                <div class="newsletter-form-group">
       https://github.com/leelachouhan23/ghost-hanoi-clone/pull/3/conflict?name=partials%252Fnewsletter.hbs&ancestor_oid=5a8c73366661297c94c9acd3218c16540e867253&base_oid=841cfe4a5b92d267c1d6627ebe492f668fb120ba&head_oid=b4f13e228bd581562e7e378eca597d549ee91e60             <input class="newsletter-input" data-members-email type="email" placeholder="Email address" required />
                    <button class="newsletter-button" type="submit">Subscribe</button>
                </div>
            </form>
        </div>
    </div>
</section>

<section class="newsletter-signup">
  <div class="newsletter-image">
    {{#if @custom.newsletter_image}}
      <img src="{{@custom.newsletter_image}}" alt="Newsletter">
    {{/if}}
  </div>
  <div class="newsletter-content">
    <h2>Letters from {{@site.title}}</h2>
    <p>A quiet edit of new stories, images, references, and notes on creative culture.</p>

    <form data-members-form="signup">
      {{#foreach @site.newsletters}}
        <label class="newsletter-option">
          <input type="checkbox" name="newsletters" value="{{id}}" {{#if @first}}checked{{/if}}>
          <span class="newsletter-option-title">{{name}}</span>
          <span class="newsletter-option-desc">{{description}}</span>
        </label>
      {{/foreach}}

      <input data-members-email type="email" placeholder="Email address" required>
      <button type="submit">Subscribe</button>
    </form>
  </div>
</section>
