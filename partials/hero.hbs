<section class="hero-section" id="hero-slider">
    {{#get "tags" limit="5" include="count.posts" order="count.posts desc" as |topTags|}}
        {{#foreach topTags}}
            {{#get "posts" filter="tag:{{slug}}" limit="1" as |tagPost|}}
                {{#foreach tagPost}}
                    <div class="hero-slide {{#if @../../first}}is-active{{/if}}" data-slide-img="{{#if feature_image}}{{img_url feature_image size="s"}}{{/if}}">
                        {{#if feature_image}}
                            <img class="hero-image" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                        {{/if}}
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tag">{{../name}}</span>
                            <h2 class="hero-title"><a href="{{url}}">{{title}}</a></h2>
                            {{#if excerpt}}
                                <p class="hero-excerpt">{{excerpt}}</p>
                            {{/if}}
                        </div>
                    </div>
                {{/foreach}}
            {{/get}}
        {{/foreach}}
        
        {{#if topTags}}
            <div class="hero-nav">
                <button aria-label="Previous slide" id="hero-prev">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                </button>
                <button aria-label="Next slide" id="hero-next">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
            </div>
            
            <div class="hero-dots">
                {{#foreach topTags}}
                    <button class="hero-dot {{#if @first}}is-active{{/if}}" data-slide-to="{{@index}}" aria-label="Go to slide {{@index}}"></button>
                {{/foreach}}
            </div>
        {{/if}}
    {{else}}
        <div class="hero-slide is-active">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h2 class="hero-title">Welcome to Hanoi</h2>
                <p class="hero-excerpt">Create some tags and posts to see them here.</p>
            </div>
        </div>
    {{/get}}
</section>

<div class="hero" style="background-color: {{@custom.brand_color}};">
  <div class="hero-inner">
    <h1 class="hero-title">{{@custom.hero_title}}</h1>
  </div>
</div>
