<section class="latest-section">
    <div class="container">
        <h2 class="latest-title">Latest Stories</h2>
        
        <div class="post-grid">
            {{#get "posts" limit="12" filter="featured:false" include="authors,tags"}}
                {{#foreach posts}}
                    <article class="post-card">
                        <a href="{{url}}" class="post-card-image-link" aria-label="{{title}}">
                            {{#if feature_image}}
                                <img class="post-card-image" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
                            {{/if}}
                        </a>
                        
                        <div class="post-card-content">
                            <div class="post-card-meta">
                                {{#if primary_tag}}
                                    <span class="post-card-tag">{{primary_tag.name}}</span>
                                {{/if}}
                            </div>
                            
                            <h3 class="post-card-title"><a href="{{url}}">{{title}}</a></h3>
                            
                            <div class="post-card-author-date">
                                {{#foreach authors}}<span class="post-card-author">{{name}}</span>{{/foreach}}
                                <span class="post-card-date">{{date format="MMMM DD, YYYY"}}</span>
                            </div>
                        </div>
                    </article>
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>
