<section class="latest-posts">
  <div class="latest-posts-inner">
    <div class="post-grid">
      {{#foreach posts}}
        {{> "post-card"}}
      {{/foreach}}
    </div>

    {{#if pagination.next}}
      <div class="load-more-wrap">
        <a class="load-more" href="{{page_url pagination.next}}">Load more</a>
      </div>
    {{/if}}
  </div>
</section>
