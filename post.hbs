{{!< default}}

{{!--
  post.hbs — Single post template
  TODO (post-template owner): implement full article layout.
  Stub below provides the minimum required by Ghost theme spec.
--}}

{{#post}}
<article class="article {{post_class}}" itemscope itemtype="https://schema.org/Article">

    <header class="article-header container">
        {{#if tags}}
            <div class="article-tags">{{tags separator=" &bull; "}}</div>
        {{/if}}
        <h1 class="article-title" itemprop="headline">{{title}}</h1>
        <div class="article-meta">
            {{#foreach authors}}
                <span itemprop="author" itemscope itemtype="https://schema.org/Person">
                    <span itemprop="name">{{name}}</span>
                </span>{{#unless @last}} &amp; {{/unless}}
            {{/foreach}}
            &middot;
            <time itemprop="datePublished" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="MMMM D, YYYY"}}
            </time>
            &middot; {{reading_time}}
        </div>
    </header>

    {{#if feature_image}}
    <div class="article-image-wrap container">
        <img
            class="article-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w,
                    {{img_url feature_image size="xl"}} 2000w"
            sizes="(max-width: 1000px) 100vw, 1000px"
            src="{{img_url feature_image size="xl"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            itemprop="image"
        />
        {{#if feature_image_caption}}
            <p class="article-image-caption">{{feature_image_caption}}</p>
        {{/if}}
    </div>
    {{/if}}

    <div class="article-body container" itemprop="articleBody">
        {{content}}
    </div>

</article>
{{/post}}
